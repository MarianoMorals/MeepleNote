<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeepleNote.Views.PrincipalPage"
             Title="Inicio"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20" RowSpacing="10">

            <!-- Header con logo y botón de perfil -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackLayout>
                    <Button Grid.Column="1" 
                            ImageSource="config.png"
                            BackgroundColor="Transparent"
                            WidthRequest="60"
                            HeightRequest="60"
                            CornerRadius="20"
                            Clicked="OnPerfilClicked"
                            HorizontalOptions="End"/>
                    <Image Source="logo.png" 
                            HeightRequest="120" 
                            WidthRequest="120"
                            HorizontalOptions="Center"/>
                </StackLayout>
                
            </Grid>

            <!-- Saludo personalizado -->
            <Label Grid.Row="1" 
                   x:Name="UserNameLabel"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}"/>

            <!-- Juego más jugado -->
            <Frame Grid.Row="2" BorderColor="{StaticResource PrimaryColor}" Padding="10">
                <StackLayout Spacing="10">
                    <Label Text="Tu juego más jugado:" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <HorizontalStackLayout Spacing="10">
                            <Image x:Name="MostPlayedGameImage" 
                                   Source="placeholder.png"
                                   WidthRequest="80"
                                   HeightRequest="80"
                                   Aspect="AspectFill"/>
                            <StackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label x:Name="MostPlayedGameLabel" FontSize="16"/>
                                <Label x:Name="PlayCountLabel" TextColor="Gray"/>
                            </StackLayout>
                        </HorizontalStackLayout>
                    </Grid>
                    <!-- Mensaje cuando no hay partidas -->
                    <Label x:Name="NoMostPlayedLabel" 
                           Text="No hay partidas registradas"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="False"
                           Padding="35"/>
                </StackLayout>
            </Frame>

            <!-- Últimas partidas -->
            <Frame Grid.Row="3" BorderColor="{StaticResource PrimaryColor}" Padding="10">
                <StackLayout>
                    <Label Text="Tus últimas partidas:" FontAttributes="Bold"/>
                    <CollectionView x:Name="RecentGamesCollection" HeightRequest="150">
                        <CollectionView.EmptyView>
                            <Label Text="No hay partidas registradas"
                                   FontSize="14"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="5">
                                    <Image Source="{Binding FotoPortada}" 
                               WidthRequest="50"
                               HeightRequest="50"
                               Aspect="AspectFill"/>

                                    <StackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding TituloJuego}" FontSize="14"/>
                                        <Label Text="{Binding Fecha, StringFormat='Jugado el {0:dd/MM/yy}'}" 
                                   FontSize="12" TextColor="Gray"/>
                                    </StackLayout>

                                    <Label Grid.Column="2" 
                               Text="{Binding Ganador, StringFormat='🏆 {0}'}"
                               VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Estadísticas rápidas -->
            <Grid Grid.Row="4" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                <Frame Grid.Column="0" Grid.Row="0" Padding="10" Margin="0,0,5,0" BorderColor="{StaticResource PrimaryColor}">
                    <StackLayout HorizontalOptions="Center">
                        <Label Text="Juegos en colección" FontAttributes="Bold" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        <Label x:Name="TotalGamesLabel" FontSize="20" HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>

                <Frame Grid.Column="1" Grid.Row="0" Padding="10" Margin="5,0,0,0" BorderColor="{StaticResource PrimaryColor}">
                    <StackLayout HorizontalOptions="Center">
                        <Label Text="Partidas totales" FontAttributes="Bold"/>
                        <Label x:Name="TotalMatchesLabel" FontSize="20" HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>

                <Button Grid.ColumnSpan="2" Grid.Row="1"
                        Text="Ver mi colección completa"
                        Clicked="OnViewCollectionClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,10"/>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>