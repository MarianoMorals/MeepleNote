<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeepleNote.Views.PartidasPublicasPage"
             Title="Partidas Públicas"
             BackgroundColor="{StaticResource BackgroundColor}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                 Command="{Binding RefreshCommand}">
        <CollectionView x:Name="PartidasPublicasList"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay partidas públicas disponibles"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="20"
                       TextColor="{StaticResource TextColor}"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="{StaticResource PrimaryColor}" 
                           CornerRadius="10" 
                           Padding="15"
                           Margin="5">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <Image Source="{Binding FotoPortada}"
                                   Grid.RowSpan="5"
                                   WidthRequest="80"
                                   HeightRequest="80"
                                   Aspect="AspectFill"/>

                            <Label Text="{Binding TituloJuego}"
                                   Grid.Column="1"
                                   FontSize="16"
                                   FontAttributes="Bold"/>

                            <Label Text="{Binding Fecha, StringFormat='🗓 {0:dd/MM/yyyy HH:mm}'}"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   FontSize="14"/>

                            <Label Text="{Binding Ciudad, StringFormat='📍 {0}'}"
                                   Grid.Column="1"
                                   Grid.Row="2"
                                   FontSize="14"/>

                            <Label Text="{Binding JugadoresRequeridos, StringFormat='👥 {0} jugadores'}"
                                   Grid.Column="1"
                                   Grid.Row="3"
                                   FontSize="14"/>

                            <Label Text="{Binding Organizador, StringFormat='Organiza: {0}'}"
                                   Grid.Column="1"
                                   Grid.Row="4"
                                   FontSize="14"
                                   FontAttributes="Italic"/>

                            <Button Text="Contactar"
                                    Grid.Column="1"
                                    Grid.Row="5"
                                    Command="{Binding Source={x:Reference PartidasPublicasList}, Path=BindingContext.ContactarCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalOptions="End"/>

                            <Button Text="Marcar como completada"
                                    Grid.Column="1"
                                    Grid.Row="6"
                                    IsVisible="{Binding EsOrganizador}"
                                    Command="{Binding Source={x:Reference PartidasPublicasList}, Path=BindingContext.CompletarCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalOptions="End"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>