<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeepleNote.Views.PartidasPublicasPage"
             Title="Partidas Públicas"
             BackgroundColor="{StaticResource BackgroundColor}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                 Command="{Binding RefreshCommand}">
        <CollectionView x:Name="PartidasPublicasList"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay partidas públicas disponibles"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="20"
                       TextColor="{StaticResource TextColor}"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="{StaticResource PrimaryColor}" 
                           CornerRadius="10" 
                           Padding="15"
                           Margin="10,5">
                        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <!-- Imagen del juego -->
                            <Image Source="{Binding FotoPortada}"
                                   Grid.Column="0"
                                   Grid.RowSpan="5"
                                   WidthRequest="70"
                                   HeightRequest="70"
                                   Aspect="AspectFill"
                                   Margin="0,0,10,0"/>

                            <!-- Datos organizados -->
                            <StackLayout Grid.Column="1" Spacing="5">
                                <Label Text="{Binding TituloJuego}"
                                       FontSize="16"
                                       FontAttributes="Bold"/>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Fecha, StringFormat='🗓 {0:dd/MM/yy}'}"
                                           FontSize="14"/>
                                    <Label Text="{Binding Fecha, StringFormat='🕒 {0:HH:mm}'}"
                                           FontSize="14"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Ciudad, StringFormat='📍 {0}'}"
                                           FontSize="14"/>
                                    <Label Text="{Binding JugadoresRequeridos, StringFormat='👥 {0} jugadores'}"
                                           FontSize="14"/>
                                </HorizontalStackLayout>

                                <Label Text="{Binding EmailContacto, StringFormat='✉ {0}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource PrimaryColor}"/>

                                <Label Text="{Binding Organizador, StringFormat='Organiza: {0}'}"
                                       FontSize="14"
                                       FontAttributes="Italic"/>
                            </StackLayout>

                            <!-- Botón en fila aparte -->
                            <Button Text="✔ Completada"
                                    Grid.ColumnSpan="2"
                                    Grid.Row="5"
                                    IsVisible="{Binding EsOrganizador}"
                                    Command="{Binding Source={x:Reference PartidasPublicasList}, Path=BindingContext.CompletarCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalOptions="End"
                                    Margin="0,10,0,0"
                                    WidthRequest="150"
                                    HeightRequest="40"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>